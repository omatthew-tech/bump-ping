{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bump ping logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to detect when you cross paths at approved public places.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need background location to detect bumps even when the app is closed.",
        "NSLocationAlwaysUsageDescription": "Background location lets us notify you about bumps.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.matthewoz101.mobile"
    },
    "android": {
      "package": "com.matthewoz101.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/bump ping logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "iosAlwaysAndWhenInUsePermission": "We detect bumps at approved public places even when the app is closed.",
          "iosWhenInUsePermission": "We use your location to find nearby public places so bumps feel contextual."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d19b8d0f-c94d-4632-8fae-42ae3677ac4e"
      }
    }
  }
}
